{
  "name": "cookly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test src/config/env/schema.test.ts tests/architecture/import-boundaries.test.mjs tests/ui-kit/*.test.* tests/shell/*.test.ts && npm run test:security && npm run test:ingredients && npm run test:pantry && npm run test:recipes && npm run test:matching && npm run test:organization && npm run test:shopping && npm run test:planner",
    "test:ui": "node --test tests/ui-kit/*.test.*",
    "test:architecture": "node --test tests/architecture/import-boundaries.test.mjs",
    "test:unit": "node --test src/config/env/schema.test.ts",
    "test:watch": "node --test --watch src/config/env/schema.test.ts tests/architecture/import-boundaries.test.mjs tests/ui-kit/*.test.* tests/shell/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:shell": "node --test tests/shell/*.test.ts",
    "test:prerender": "node tests/shell/prerender.smoke.mjs",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:security": "node --conditions=react-server --test tests/security/*.test.ts",
    "test:access-routes": "node --conditions=react-server --test tests/security/routes.smoke.mjs",
    "test:ingredients": "node --conditions=react-server --test tests/ingredients/*.test.ts",
    "test:ingredient-routes": "node --conditions=react-server --test tests/ingredients/routes.smoke.mjs",
    "test:pantry": "node --conditions=react-server --test tests/pantry/*.test.ts",
    "test:pantry-routes": "node --conditions=react-server --test tests/pantry/routes.smoke.mjs",
    "test:recipes": "node --test tests/recipes/*.test.ts",
    "recipes:validate": "node scripts/recipes/cli.ts validate",
    "recipes:export": "node scripts/recipes/cli.ts export",
    "recipes:import": "node scripts/recipes/cli.ts import",
    "recipes:references": "node scripts/recipes/reference-sql.ts",
    "recipes:check": "node scripts/recipes/check.ts",
    "test:matching": "node --test tests/matching/*.test.ts",
    "matching:demo": "node scripts/matching/demo.ts",
    "matching:benchmark": "node scripts/matching/benchmark.ts",
    "test:recipe-detail-routes": "node --conditions=react-server --test tests/recipes/detail-routes.smoke.mjs",
    "test:recipe-search-routes": "node --conditions=react-server --test tests/recipes/search-routes.smoke.mjs",
    "test:organization-routes": "node --conditions=react-server --test tests/organization/routes.smoke.mjs",
    "test:shopping": "node --test tests/shopping/*.test.ts",
    "test:shopping-routes": "node --conditions=react-server --test tests/shopping/routes.smoke.mjs",
    "test:organization": "node --test tests/organization/*.test.ts",
    "test:planner": "node --test tests/planner/*.test.ts",
    "test:planner-routes": "node --conditions=react-server --test tests/planner/routes.smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
