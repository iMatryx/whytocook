# Cookly — configurare locala; NU contine credentiale reale.
# Copia locala va fi .env.local, la radacina proiectului, exclusa din Git.
# Shell-ul porneste fara Supabase. O integrare activata cere valori valide.

# Configurare server obisnuita, neconfidentiala.
COOKLY_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
SUPABASE_MEDIA_BUCKET=recipe-media
SUPABASE_EXPORTS_BUCKET=account-exports

# Publice: configureaza perechea complet sau lasa ambele goale.
# Se accepta chei moderne sb_publishable_*, niciodata sb_secret_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Rezervat mutatiilor viitoare; shell-ul nu are mutatii de business.
# Genereaza separat minimum 32 bytes aleatorii; fara fallback de productie.
CSRF_SECRET=

# Numai executorul de mentenanta: valideaza separat de serverul obisnuit.
# Executorul nu este implementat/activat in aceasta etapa.
SUPABASE_SECRET_KEY=
JOBS_SIGNING_SECRET=

# Nu sunt necesare DATABASE_URL, token CLI sau credentiale SMTP in browser.
# Credentialele de migrare/CLI sunt injectate separat in jobul CI autorizat.
# Cheile AI/billing si flagurile lor se adauga numai in etapa V2 aprobata.
