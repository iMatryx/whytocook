# Cookly — configurare locala; NU contine credentiale reale.
# Copia locala va fi .env.local, la radacina proiectului, exclusa din Git.
# Shell-ul porneste fara Supabase. Endpointurile de acces cer perechea publica.
# Setup local: docs/database/SUPABASE-SECURITY.md; nu copia outputul CLI integral.

# Configurare server obisnuita, neconfidentiala.
COOKLY_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
LOG_LEVEL=info
SUPABASE_MEDIA_BUCKET=recipe-media
SUPABASE_EXPORTS_BUCKET=account-exports

# Publice: configureaza perechea complet sau lasa ambele goale.
# Se accepta chei moderne sb_publishable_*, niciodata sb_secret_* sau JWT service_role.
# Local: URL-ul API afisat de `supabase start` (uzual http://127.0.0.1:54321)
# si valoarea PUBLISHABLE_KEY. Lasa goale aici; valorile locale stau in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Necesar pentru autentificare: criptarea cookie-ului si protectia mutatiilor.
# Genereaza local minimum 32 bytes aleatorii (ex. `openssl rand -base64 32`).
# APP_BASE_URL trebuie sa fie originea exacta deschisa in browser; HTTPS in productie.
CSRF_SECRET=

# Numai executorul de mentenanta: valideaza separat de serverul obisnuit.
# Executorul nu este implementat/activat in aceasta etapa.
SUPABASE_SECRET_KEY=
JOBS_SIGNING_SECRET=

# Nu sunt necesare DATABASE_URL, token CLI sau credentiale SMTP in browser.
# Credentialele de migrare/CLI sunt injectate separat in jobul CI autorizat.
# Cheile AI/billing si flagurile lor se adauga numai in etapa V2 aprobata.
